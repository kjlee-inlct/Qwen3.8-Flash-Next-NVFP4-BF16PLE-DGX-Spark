+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Validate offered Qwen3 tool arguments without remote JSON schema fetching."""
+from __future__ import annotations
+
+import json
+from jsonschema import SchemaError, ValidationError
+from jsonschema.validators import validator_for
+from referencing import Registry
+from referencing.exceptions import Unresolvable
+
+
+class InvalidToolArguments(ValueError):
+    """Unsafe/invalid arguments (never place tool inputs in error messages)."""
+
+
+def _unique(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("Duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _constant(value):
+    raise ValueError("Invalid JSON numeric literal")
+
+
+def _parse(value):
+    return json.loads(value, object_pairs_hook=_unique, parse_constant=_constant)
+
+
+def find_parameters(tools, name):
+    matches = []
+    for item in tools or []:
+        item = item.model_dump() if hasattr(item, "model_dump") else item
+        if not isinstance(item, dict):
+            continue
+        if item.get("type") == "namespace":
+            ns = item.get("name")
+            for child in item.get("tools", []):
+                if (isinstance(child, dict) and child.get("type") == "function"
+                        and ns and ns + "__" + child.get("name", "") == name):
+                    matches.append(child.get("parameters"))
+        elif item.get("type") == "function":
+            func = item.get("function", item)
+            if isinstance(func, dict) and func.get("name") == name:
+                matches.append(func.get("parameters"))
+    return matches[0] if len(matches) == 1 else None
+
+
+def validate_or_unwrap(value: str, schema: dict):
+    """Preserve a valid JSON object; unwrap exactly one proven wrapper."""
+    try:
+        if isinstance(schema, dict) and "$schema" in schema:
+            cls = validator_for(schema, default=None)
+            if cls is None:
+                raise InvalidToolArguments("Unsupported schema dialect")
+        else:
+            cls = validator_for(schema)
+        cls.check_schema(schema)
+        validator = cls(schema, registry=Registry())
+        original = _parse(value)
+        if not isinstance(original, dict):
+            raise InvalidToolArguments("Expected JSON arguments object")
+        try:
+            validator.validate(original)
+            return value
+        except ValidationError:
+            pass
+        if set(original) != {"arguments"}:
+            raise InvalidToolArguments("Arguments do not satisfy offered schema")
+        inner = original["arguments"]
+        if isinstance(inner, str):
+            inner = _parse(inner)
+        if not isinstance(inner, dict):
+            raise InvalidToolArguments("Arguments wrapper is invalid")
+        validator.validate(inner)
+        return json.dumps(inner, ensure_ascii=False, allow_nan=False)
+    except InvalidToolArguments:
+        raise
+    except (SchemaError, ValidationError, Unresolvable, ValueError, TypeError,
+            KeyError, RecursionError) as exc:
+        raise InvalidToolArguments("Arguments do not satisfy offered schema") from None
