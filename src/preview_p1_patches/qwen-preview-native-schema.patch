+    def _check_skip_tool_parsing(self, request):
+        # Keep the usual Chat path untouched. Strict mode is per parser/request.
+        from vllm.entrypoints.openai.responses.protocol import ResponsesRequest
+        super()._check_skip_tool_parsing(request)
+        self._strict_responses_arguments = (
+            self.CONFIG_NAME == "qwen3" and isinstance(request, ResponsesRequest)
+        )
+
+    def _reset(self, initial_state=None):
+        super()._reset(initial_state=initial_state)
+        self._invalid_argument_slots.clear()
+
+    def _reject_arguments(self, idx: int) -> None:
+        self._invalid_argument_slots.add(idx)
+
+    def _normalize_tool_arguments(self, value: str, name: str, idx: int) -> str | None:
+        if not self._strict_responses_arguments:
+            return value
+        schema = find_parameters(self._tools, name)
+        if schema is None:  # An unoffered/ambiguous tool cannot become executable.
+            self._reject_arguments(idx)
+            return None
+        try:
+            return validate_or_unwrap(value, schema)
+        except InvalidToolArguments:
+            self._reject_arguments(idx)
+            return None
+
+    def _handle_arg_chunk(self, event, deltas):
+        if not self._strict_responses_arguments:
+            return super()._handle_arg_chunk(event, deltas)
+        idx = event.tool_index
+        if event.value:
+            self._tool_slots[idx].append_args(event.value)
+        # Response deltas must not expose an unvalidated JSON prefix.
+
+    def _handle_tool_end(self, event, deltas):
+        if not self._strict_responses_arguments:
+            return super()._handle_tool_end(event, deltas)
+        idx = event.tool_index
+        if idx >= len(self._tool_slots):
+            return
+        slot = self._tool_slots[idx]
+        if event.value not in (FUNC_END, TOOL_CALL_END):
+            self._reject_arguments(idx)  # Incomplete EOF cannot authorize a call.
+            return
+        name = slot.name or self._try_extract_name(idx) or ""
+        if not self._accept_tool_name(name):
+            self._reject_arguments(idx)
+            return
+        try:
+            raw = self._arg_converter(slot.args, False) if self._arg_converter else slot.args
+        except (ValueError, TypeError):
+            self._reject_arguments(idx)
+            return
+        value = self._normalize_tool_arguments(self._fix_arg_types(raw, name), name, idx)
+        if value is None:
+            return
+        self._ensure_tool_id(slot, name)
+        slot.name_sent = True
+        deltas.append(DeltaToolCall(
+            index=idx, id=slot.id, type="function",
+            function=DeltaFunctionCall(name=name, arguments=value),
+        ))
 
